{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota-manager.local/contracts/snapshot.schema.json",
  "title": "Quota Manager snapshot schemaVersion 1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "refreshIntervalSeconds": { "type": "integer", "minimum": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "analytics": { "type": "object" }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["id", "name", "enabled", "accounts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "defaultModel": { "type": ["string", "null"] },
        "supportedModels": { "type": "array", "items": { "type": "string" } },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/account" } },
        "analytics": { "type": "object" }
      }
    },
    "account": {
      "type": "object",
      "required": ["id", "label", "status", "windows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "plan": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["ok", "stale", "reauth", "paused", "unavailable", "collecting"]
        },
        "updatedAt": { "type": ["string", "null"] },
        "active": { "type": "boolean" },
        "quotaMode": { "type": ["string", "null"] },
        "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "analytics": { "type": "object" }
      }
    },
    "window": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "remainingPercent": { "type": ["number", "null"] },
        "stale": { "type": "boolean" },
        "resetAt": { "type": ["string", "null"] },
        "usageScope": { "type": ["string", "null"] },
        "analytics": { "type": "object" }
      }
    }
  }
}
